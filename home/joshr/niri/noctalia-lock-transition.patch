+void LockSurface::startUnlockTransition(std::function<void()> onComplete) {
+  m_locked = false;
+  m_inputDispatcher.setFocus(nullptr);
+  m_animations.cancelForOwner(this);
+
+  const float backgroundStart = m_backgroundLayer != nullptr ? m_backgroundLayer->opacity() : 1.0f;
+  const float widgetOpacityStart = m_widgetLayer != nullptr ? m_widgetLayer->opacity() : 1.0f;
+  const float widgetScaleStart = m_widgetLayer != nullptr ? m_widgetLayer->scale() : 1.0f;
+
+  m_animations.animate(
+      0.0f,
+      1.0f,
+      280.0f,
+      Easing::EaseInOutCubic,
+      [this, backgroundStart, widgetOpacityStart, widgetScaleStart](float progress) {
+        if (m_backgroundLayer != nullptr) {
+          m_backgroundLayer->setOpacity(backgroundStart * (1.0f - progress));
+        }
+        if (m_widgetLayer != nullptr) {
+          m_widgetLayer->setOpacity(widgetOpacityStart * (1.0f - progress));
+          m_widgetLayer->setScale(widgetScaleStart + (0.97f - widgetScaleStart) * progress);
+        }
+        requestUpdate();
+      },
+      std::move(onComplete),
+      this
+  );
+  requestUpdate();
+}
+
 bool LockSurface::passwordFieldContainsPoint(float sceneX, float sceneY) const {
   return m_passwordField != nullptr && m_passwordField->containsScenePoint(sceneX, sceneY);
 }
