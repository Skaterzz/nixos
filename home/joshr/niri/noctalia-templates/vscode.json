    "terminal.ansiBrightWhite": "{{ colors.terminal_bright_white.default.hex }}",
    "terminal.ansiBrightYellow": "{{ colors.terminal_bright_yellow.default.hex }}",
    "terminal.ansiCyan": "{{ colors.terminal_normal_cyan.default.hex }}",
    "terminal.ansiGreen": "{{ colors.terminal_normal_green.default.hex }}",
    "terminal.ansiMagenta": "{{ colors.terminal_normal_magenta.default.hex }}",
    "terminal.ansiRed": "{{ colors.terminal_normal_red.default.hex }}",
    "terminal.ansiWhite": "{{ colors.terminal_normal_white.default.hex }}",
    "terminal.ansiYellow": "{{ colors.terminal_normal_yellow.default.hex }}",
    "terminal.background": "{{ colors.terminal_background.default.hex }}",
    "terminal.foreground": "{{ colors.terminal_foreground.default.hex }}",
    "terminalCursor.background": "{{ colors.terminal_cursor_text.default.hex }}",
    "terminalCursor.foreground": "{{ colors.terminal_cursor.default.hex }}",
    "textLink.activeForeground": "{{ colors.secondary.default.hex }}",
    "textLink.foreground": "{{ colors.primary.default.hex }}",
    "titleBar.activeBackground": "{{ colors.surface.default.hex }}",
    "titleBar.activeForeground": "{{ colors.on_surface.default.hex }}",
    "titleBar.inactiveBackground": "{{ colors.surface_variant.default.hex }}",
    "titleBar.inactiveForeground": "{{ colors.on_surface_variant.default.hex }}",
    "widget.border": "{{ colors.outline_variant.default.hex }}",
    "widget.shadow": "{{ colors.shadow.default.hex }}80"
  },
  "semanticTokenColors": {
    "class": "{{ colors.terminal_normal_yellow.default.hex }}",
    "enumMember": "{{ colors.primary.default.hex }}",
    "function": "{{ colors.terminal_normal_blue.default.hex }}",
    "interface": "{{ colors.terminal_normal_yellow.default.hex }}",
    "parameter": "{{ colors.terminal_normal_cyan.default.hex }}",
    "property": "{{ colors.terminal_normal_cyan.default.hex }}",
    "type": "{{ colors.terminal_normal_yellow.default.hex }}",
    "variable.readonly": "{{ colors.tertiary.default.hex }}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "{{ colors.terminal_normal_green.default.hex }}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "{{ colors.tertiary.default.hex }}" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "{{ colors.terminal_normal_magenta.default.hex }}" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "{{ colors.terminal_normal_blue.default.hex }}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type"], "settings": { "foreground": "{{ colors.terminal_normal_yellow.default.hex }}" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "{{ colors.on_background.default.hex }}" } },
    { "scope": ["variable.parameter", "variable.other.property"], "settings": { "foreground": "{{ colors.terminal_normal_cyan.default.hex }}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{ colors.error.default.hex }}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "{{ colors.primary.default.hex }}" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "{{ colors.primary.default.hex }}", "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{ colors.terminal_normal_green.default.hex }}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{ colors.error.default.hex }}" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "{{ colors.on_error.default.hex }}", "background": "{{ colors.error.default.hex }}" } }
  ]
}
