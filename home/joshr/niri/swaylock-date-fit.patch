+			/* --datestr may carry a newline (strftime %n), which stacks
+			 * it as two lines -- "Wednesday" over "September 24" rather
+			 * than one long row. cairo_show_text has no notion of a line
+			 * break, so the split is done here. timetext() hands back a
+			 * static buffer that strftime rewrites every frame, so
+			 * terminating it in place is safe.
+			 */
+			char *date_l2 = NULL;
+			for (char *p = text_l2; *p; p++) {
+				if (*p == '\n') {
+					*p = '\0';
+					date_l2 = p + 1;
+					break;
+				}
+			}
+
+			/* Then fit each line inside the ring.
+			 *
+			 * The date's size is otherwise a fixed fraction of the
+			 * radius, so a long line overhangs the circle by the same
+			 * proportion at every radius -- a wider indicator cannot buy
+			 * room, and --font-size only reaches the clock above. Each
+			 * line is bounded by the ring's inner chord at its own
+			 * baseline rather than by the diameter, because the date sits
+			 * below the centre where the circle has already narrowed.
+			 *
+			 * Stacking normally keeps both lines short enough that no
+			 * scaling happens at all; this is the backstop that makes an
+			 * overhang impossible for any format or locale.
+			 */
+			double date_size = arc_radius / 6.0f;
+			double date_mid = arc_radius / 3.5f;
+			double date_step = date_size * 1.15;
+			double inner_r = arc_radius - arc_thickness / 2.0;
+
+			char *date_lines[2] = { text_l2, date_l2 };
+			double date_offs[2] = { date_mid, date_mid };
+			int date_n = date_l2 ? 2 : 1;
+
+			/* One line keeps its old position; two straddle it. */
+			if (date_n == 2) {
+				date_offs[0] = date_mid - date_step / 2.0;
+				date_offs[1] = date_mid + date_step / 2.0;
+			}
+
+			for (int i = 0; i < date_n; i++) {
+				double off = date_offs[i];
+				double chord = inner_r > off ? 2.0 * sqrt(
